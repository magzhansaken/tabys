# =====================================================================
# Что НЕ попадает в репозиторий.
#
# Два правила, за которыми стоят реальные неприятности у других команд:
#   · секреты в истории remain навсегда — даже если удалить файл потом,
#     он останется в прошлых записях, и пароль придётся менять;
#   · тяжёлые собранные файлы раздувают репозиторий так, что скачивание
#     занимает минуты, а хранилище кончается.
# =====================================================================

# ── СЕКРЕТЫ. Никогда. Пароли базы и ключ подписи живут только на сервере
.env
.env.*
!.env.prod.example
*.pem
*.key
!**/lib/**/*.key

# ── Зависимости: восстанавливаются командой установки
node_modules/
.pnp/
.pnp.js

# ── Собранное: пересоздаётся сборкой
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Касса: установщик весит 270 МБ, в репозиторий ему нельзя
pos-desktop/dist/
pos-desktop/node_modules/
*.exe
*.msi
*.apk
*.aab

# ── Flutter
pos/build/
pos/.dart_tool/
pos/android/
pos/ios/
pos/windows/
pos/.flutter-plugins*
*.g.dart

# ── Бэкапы базы: там боевые данные клиентов
deploy/backups/
*.sql.gz
*.dump

# ── Журналы и временное
*.log
*.tmp
tmp/
.DS_Store
Thumbs.db

# ── Личные настройки редакторов
.vscode/
.idea/
*.swp

# ── Испорченные файлы кассы (создаются при сбое чтения)
*.broken-*

# Файлы сборки касс (.github/workflows) не заливаются этим токеном:
# у него нет права workflow. Лежат отдельно, добавим при смене токена.
.github/workflows/
