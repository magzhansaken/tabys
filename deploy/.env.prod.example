# =====================================================================
# ТАБЫС — боевые настройки. Файл лежит на сервере: /opt/tabys/deploy/.env
# В git НЕ коммитить. Пароли генерируются на сервере, в переписке их нет.
# =====================================================================

# Пароль суперпользователя базы (postgres). Используется только внутри докера.
DB_SUPER_PASSWORD=СГЕНЕРИРУЕТСЯ_НА_СЕРВЕРЕ

# Пароль роли приложения shop_app — под ней ходит сервер.
# Важно: роль БЕЗ прав суперпользователя, иначе она обошла бы изоляцию
# магазинов друг от друга (RLS).
DB_APP_PASSWORD=СГЕНЕРИРУЕТСЯ_НА_СЕРВЕРЕ

# Ключ подписи токенов входа. Смена ключа = разлогинит всех.
JWT_SECRET=СГЕНЕРИРУЕТСЯ_НА_СЕРВЕРЕ

# Адрес API для браузера. Caddy принимает /api/* и отдаёт серверу.
PUBLIC_API_URL=https://tabys.duckdns.org/api
