{
  "name": "tabys-kassa",
  "version": "3.0.0",
  "description": "Касса магазина «Табыс»",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js && node test/shell.test.js",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kz.tabys.kassa",
    "productName": "Tabys Kassa",
    "artifactName": "Tabys-Kassa-${version}-setup.${ext}",
    "files": ["electron/**/*", "renderer/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Табыс Касса"
    }
  }
}
